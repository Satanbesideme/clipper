{
  "_about": "GALSURKU Clipper. Dark editor UI, Rams-style: neutral greys, one signal orange used only for actions and the playhead.",
  "color": {
    "bg": "#121212",
    "surface": "#1c1c1c",
    "surface-2": "#262626",
    "border": "#2e2e2e",
    "border-input": "#6b6b6b",
    "text": "#ededed",
    "text-muted": "#a3a3a3",
    "accent": "#ff6a1a",
    "on-accent": "#121212",
    "danger": "#ff5c5c",
    "success": "#4cc38a",
    "warning": "#f2c14e",
    "marker": "#ff6a1a"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text", "surface-2"],
    ["text-muted", "bg"], ["text-muted", "surface"], ["text-muted", "surface-2"],
    ["on-accent", "accent"], ["accent", "bg"], ["accent", "surface"],
    ["danger", "surface"], ["success", "surface"], ["warning", "surface"],
    ["border-input", "surface", "ui"], ["accent", "surface-2", "ui"]
  ],
  "font": {
    "sans": "Inter, system-ui, Segoe UI, sans-serif",
    "mono": "JetBrains Mono, ui-monospace, Consolas, monospace"
  },
  "type": {
    "xs": {"size": 11, "line": 16, "weight": 500},
    "sm": {"size": 13, "line": 18, "weight": 400},
    "base": {"size": 14, "line": 20, "weight": 400},
    "lg": {"size": 16, "line": 22, "weight": 600},
    "xl": {"size": 20, "line": 26, "weight": 600}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48],
  "radius": {"sm": 3, "md": 6, "lg": 10, "pill": 999},
  "shadow": {"pop": "0 8px 24px rgba(0,0,0,.5)"},
  "motion": {"fast": "100ms", "base": "160ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
  "layout": {"titlebar": 36, "sidebar": 280, "inspector": 320, "timeline_min": 180}
}
